VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Login gate for the dashboard. Default is unset/false — the app behaves
# exactly as it did before auth existed, even if the two vars above are
# set. Only set this to "true" AFTER creating users in the Supabase
# Dashboard and notifying the team, or existing users will be locked out
# with no warning. See README.md for the full rollout checklist.
VITE_REQUIRE_AUTH=false
